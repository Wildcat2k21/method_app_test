@startuml lb1_check_move
title Граф потока управления: core::rules::check_move
skinparam shadowing false

start
:check_move(board, body, next);
if (B1: board.contains(next)?\nC1 x ≥ 0  C2 x < width\nC3 y ≥ 0  C4 y < height) then (нет)
  :Err(Collision::Wall);
  stop
else (да)
endif
:B2: blocking = body[..len − 1]\n(C5: len = 0 → пустой срез);
if (B3: blocking.contains(next)?) then (да)
  :Err(Collision::Body);
  stop
else (нет)
endif
:B4: Ok(());
stop
@enduml
